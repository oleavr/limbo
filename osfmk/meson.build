subdir('bootstrap')

osfmk_lib = static_library('osfmk',
  sources: [
    'clock.c',
    'clockServer.c',
    'deviceServer.c',
    'handler.c',
    'host_priv.c',
    'host_privServer.c',
    'iokit.c',
    'broker_client.c',
    'ipc.c',
    'mach_host.c',
    'mach_hostServer.c',
    'mach_port.c',
    'mach_portServer.c',
    'mach_vm.c',
    'mach_vmServer.c',
    'mach_voucherServer.c',
    'mk_timer.c',
    'osserialize.c',
    'processor_set.c',
    'processor_setServer.c',
    'semaphore.c',
    'task.c',
    'taskServer.c',
    'task_restartable.c',
    'task_restartableServer.c',
    'thread_act.c',
    'thread_actServer.c',
    'voucher.c',
    'libinfo.c',
    'xpc_bootstrap.c',
  ],
  include_directories: include_dir,
  c_args: [
    '-Wno-packed-not-aligned',
    '-Wno-unused-parameter',
    '-Wno-pedantic',
    '-Wno-int-to-pointer-cast',
    '-Wno-uninitialized',
    '-Wno-attributes',
  ],
  link_with: [bootstrap_lib],
)
