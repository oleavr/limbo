bsd_lib = static_library('bsd',
  sources: [
    'handler.c',
    'kevent.c',
    'csr.c',
    'mac.c',
    'map_with_linking.c',
    'codesign.c',
    'proc_info.c',
    'process.c',
    'sha.c',
    'psynch.c',
    'pthread.c',
    'signo.c',
    'spawn.c',
    'sysctl.c',
    'ulock.c',
    'fs/stat.c',
    'fs/at.c',
    'fs/attrlist.c',
    'fs/fcntl.c',
    'fs/bsd_flags.c',
    'fs/fileid.c',
    'fs/getdirentries.c',
    'fs/xattr.c',
  ],
  include_directories: include_dir,
  c_args: [
    '-Wno-packed-not-aligned',
    '-Wno-unused-parameter',
    '-Wno-pedantic',
    '-Wno-int-to-pointer-cast',
  ],
)
